#!/bin/sh
set -eu
cd "$(git rev-parse --show-toplevel)"
fail() { printf '%s\n' "pre-push: $*" >&2; exit 1; }
head=$(git rev-parse HEAD)
updates=0
pushes=0
set --
while read -r local_ref local_oid remote_ref remote_oid extra; do
  [ -n "$local_ref" ] && [ -n "$local_oid" ] && [ -n "$remote_ref" ] && [ -n "$remote_oid" ] && [ -z "$extra" ] || fail "Malformed update on stdin."
  for oid in "$local_oid" "$remote_oid"; do
    case "$oid" in *[!0-9a-f]*) fail "Invalid object ID." ;; esac
    [ "${#oid}" -eq 40 ] || [ "${#oid}" -eq 64 ] || fail "Invalid object ID length."
  done
  updates=$((updates + 1))
  case "$local_oid" in *[!0]*) ;; *) continue ;; esac
  [ "$local_oid" = "$head" ] || fail "Check out the exact commit being pushed. Multiple distinct pushed commits need separate validation."
  pushes=$((pushes + 1))
  set -- "$@" "$remote_oid"
done
[ "$updates" -gt 0 ] || fail "Expected Git pre-push update records on stdin."
[ "$pushes" -gt 0 ] || exit 0
status=$(git status --porcelain --untracked-files=normal) || fail "Could not inspect checkout."
[ -z "$status" ] || fail "A clean checkout of the pushed commit is required. Commit or separately preserve edits; this hook never stashes them."
exec sh scripts/check-push.sh "$@"
