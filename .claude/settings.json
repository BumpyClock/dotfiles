      "Bash(awk:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(cat:*)",
      "Bash(less:*)",
      "Bash(more:*)",
      "Bash(diff:*)",
      "Bash(diff3:*)",
      "Bash(patch:*)",
      "Bash(cut:*)",
      "Bash(paste:*)",
      "Bash(join:*)",
      "Bash(tr:*)",
      "Bash(col:*)",
      "Bash(expand:*)",
      "Bash(unexpand:*)",
      "Bash(fmt:*)",
      "Bash(find:*)",
      "Bash(xargs:*)",
      "Bash(file:*)",
      "Bash(stat:*)",
      "Bash(readlink:*)",
      "Bash(du:*)",
      "Bash(df:*)",
      "Bash(which:*)",
      "Bash(whereis:*)",
      "Bash(locate:*)",
      "Bash(basename:*)",
      "Bash(dirname:*)",
      "Bash(realpath:*)",
      "Bash(tar:*)",
      "Bash(zip:*)",
      "Bash(unzip:*)",
      "Bash(gzip:*)",
      "Bash(gunzip:*)",
      "Bash(bzip2:*)",
      "Bash(bunzip2:*)",
      "Bash(xz:*)",
      "Bash(unxz:*)",
      "Bash(ditto:*)",
      "Bash(ps:*)",
      "Bash(top:*)",
      "Bash(kill:*)",
      "Bash(killall:*)",
      "Bash(pgrep:*)",
      "Bash(pkill:*)",
      "Bash(lsof:*)",
      "Bash(netstat:*)",
      "Bash(ifconfig:*)",
      "Bash(ping:*)",
      "Bash(traceroute:*)",
      "Bash(nslookup:*)",
      "Bash(dig:*)",
      "Bash(host:*)",
      "Bash(whoami:*)",
      "Bash(id:*)",
      "Bash(groups:*)",
      "Bash(uname:*)",
      "Bash(uptime:*)",
      "Bash(date:*)",
      "Bash(cal:*)",
      "Bash(env:*)",
      "Bash(printenv:*)",
      "Bash(jq:*)",
      "Bash(xmllint:*)",
      "Bash(sqlite3:*)",
      "Bash(openssl:*)",
      "Bash(base64:*)",
      "Bash(md5:*)",
      "Bash(sha1:*)",
      "Bash(sha256:*)",
      "Bash(shasum:*)",
      "Bash(cksum:*)",
      "Bash(tee:*)",
      "Bash(yes:*)",
      "Bash(hdiutil:*)",
      "Bash(pkgbuild:*)",
      "Bash(productbuild:*)",
      "Bash(productsign:*)",
      "Bash(pkgutil:*)",
      "Bash(profiles:*)",
      "Bash(defaults:*)",
      "Bash(osascript:*)",
      "Bash(automator:*)",
      "Bash(say:*)",
      "Bash(screencapture:*)",
      "Bash(caffeinate:*)",
      "Bash(vim:*)",
      "Bash(vi:*)",
      "Bash(nano:*)",
      "Bash(pico:*)",
      "Bash(ed:*)",
      "Bash(man:*)",
      "Bash(apropos:*)",
      "Bash(whatis:*)",
      "Bash(info:*)",
      "Bash(time:*)",
      "Bash(timeout:*)",
      "Bash(dtrace:*)",
      "Bash(dtruss:*)",
      "Bash(rm:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(go tool golangci-lint run:*)",
      "Bash(go doc:*)",
      "Bash(go list -m -f '{{.Path}} {{.Version}}' all)",
      "WebSearch",
      "WebFetch(domain:platform.openai.com)",
      "Bash(rg: *)",
      "Bash(ast-grep: *)",
      "Bash(coderabbit: *)",
      "Bash(committer:*)"
    ],
    "deny": ["CronCreate",
      "CronDelete",
      "CronList",
      "RemoteTrigger",
      "ReportFindings",
      "ScheduleWakeup",
      "PushNotification",
      "SendMessage",
      "DesignSync",
      "NotebookEdit",
      "EnterPlanMode",
      "ExitPlanMode"],
    "ask": [
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git * main)"
    ]
  },
  "model": "haiku",
  "enableAllProjectMcpServers": true,
  "statusLine": {
    "type": "command",
    "command": "ccline",
    "padding": 0,
    "refreshInterval": 10
  },
  "enabledPlugins": {
    "security-guidance@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "figma@claude-plugins-official": false,
    "codex@openai-codex": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "modelSettings": {
    "gpt-5.6-sol": {
      "effortLevel": "high"
    }
  },
  "advisorModel": "fable",
  "tui": "fullscreen",
  "disableBundledSkills": true,
  "disableRemoteControl": true,
  "disableClaudeAiConnectors": true,
  "disableArtifact": true,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "teammateMode": "in-process",
  "agentPushNotifEnabled": true,
  "feedbackSurveyState": {
    "lastShownTime": 1754001410798
  }
}
