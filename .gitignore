.DS_Store
AGENTS.local.md
__pycache__
*.py[cod]

# Secrets submodule - don't ignore the submodule itself,
# but do ignore any local secret files that might accidentally get created
secrets/*.env
secrets/api-keys/*.env
secrets/config/*.conf
secrets/tokens/*
!secrets/templates/
node_modules/
.ai_agents/session_context
.claude/session_context

# Local clones of agent marketplaces / vendored skills — see README (agent-templates note)
agents/
agents-reference/
skills/

# lsp-mcp logs
./lsp-mcp/logs/*
./lsp-mcp/semanticSearch/*
.lsp-mcp/
*.zip
.tasque/
.pi-lens/

# Editor backup files
*.save

# Bun build cache artifacts
*.bun-build
**/.pi-subagents
